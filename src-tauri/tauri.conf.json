{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "0.2.0",
  "identifier": "com.joseh.planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Planner",
        "maximized": true,
        "fullscreen": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/elpollo12/planner-desktop-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RjNFOTg1QUVGRTU2MjQKUldRa1Z2NnVoZW56bHEwYUcyVUpvSU9KVnNBUFJDaVZwY1dvbXpnVTM1QTVNMnNxNlJQbExJZkoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
