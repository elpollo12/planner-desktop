# DDR Planner - Variables de Entorno
# Copia este archivo como .env y configura los valores

# ============================================================================
# Turso Cloud Sync (Opcional)
# ============================================================================
# Para habilitar la sincronización en la nube con Turso, configura estas variables.
# Si no se configuran, la aplicación funcionará solo con la base de datos local.

# URL de la base de datos Turso
# Formato: libsql://tu-base-de-datos-org.turso.io
# Obtén esta URL con: turso db show tu-db --url
TURSO_DATABASE_URL=

# Token de autenticación de Turso
# Genera este token con: turso db tokens create tu-db
TURSO_AUTH_TOKEN=

# ============================================================================
# Instrucciones de configuración
# ============================================================================
# 1. Crea una cuenta en https://turso.tech
# 2. Instala el CLI: curl -sSfL https://get.tur.so/install.sh | bash
# 3. Inicia sesión: turso auth login
# 4. Crea una base de datos: turso db create ddr-planner
# 5. Obtén la URL: turso db show ddr-planner --url
# 6. Genera un token: turso db tokens create ddr-planner
# 7. Copia los valores a este archivo
# 8. Reinicia la aplicación

# ============================================================================
# Notas de seguridad
# ============================================================================
# - NUNCA compartas el archivo .env con las credenciales
# - Añade .env a tu .gitignore
# - El TURSO_AUTH_TOKEN es sensible - mantenlo seguro
# - Las credenciales solo son necesarias en un cliente (el servidor central)
#   Los demás clientes sincronizarán a través de ese servidor
